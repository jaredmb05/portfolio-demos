# Copy to .env, fill in, then run: node scripts/write-config.mjs
# That writes apps/shared/config.js (git-ignored), which both apps load at startup.

# Firebase web config for a DEMO project (Firebase console → Project settings → Your apps → Web app).
# Never point this at a production project. The web config is public by design; the Firestore rules control access.
FIREBASE_API_KEY=your-demo-web-api-key
FIREBASE_AUTH_DOMAIN=your-demo-project.firebaseapp.com
FIREBASE_PROJECT_ID=your-demo-project
FIREBASE_STORAGE_BUCKET=your-demo-project.firebasestorage.app
FIREBASE_MESSAGING_SENDER_ID=000000000000
FIREBASE_APP_ID=1:000000000000:web:0000000000000000

# Manager PIN for the quiz results, the staff list and the weekly schedule. Required: with no PIN those stay locked.
# It is checked in the browser, so it is a deterrent, not security (see D4 in docs/DECISIONS.md).
MANAGER_PIN=change-me
